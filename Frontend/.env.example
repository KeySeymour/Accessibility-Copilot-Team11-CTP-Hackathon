# Copy this file to `.env.local` and fill in your key.
#
#     cp .env.example .env.local
#
# `.env.local` is gitignored. NEVER rename these to NEXT_PUBLIC_* — that prefix
# inlines the value into the JavaScript bundle sent to every visitor's browser,
# which would publish your key. These stay server-side only, read by
# lib/scan/gemini.ts inside route handlers and the scan runner.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.7-flash. Run `npm run gemini:check` to list
# the models your key can actually reach — older ones get retired for new keys.
# GEMINI_MODEL=gemini-3.7-flash

# Optional. Set to "0" to turn the AI pass off without removing your key —
# scans then run axe-core only.
# GEMINI_ENABLED=1

# Optional. Generates a polished redesigned image for uploaded screenshots.
# Falls back to the deterministic preview if this model is unavailable.
# GEMINI_IMAGE_ENABLED=1
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional. URL previews default to the exact axe-verified DOM screenshot.
# Set to "1" only if you also want an unverified visual-polish image pass.
# GEMINI_URL_POLISH_ENABLED=0
